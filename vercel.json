{
  "rewrites": [{ "source": "/((?!assets/|images/|videos/|favicon|sitemap.xml|robots.txt).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(images|videos|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
