{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|videos/|favicon|sitemap.xml|robots.txt).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(images|videos|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/excursiones/buggy-rio-lodo",
      "destination": "/excursiones/buggy-maimon-playa-teco",
      "permanent": true
    },
    {
      "source": "/excursiones/buggy-costa-playa",
      "destination": "/excursiones/buggy-maimon-playa-teco",
      "permanent": true
    },
    {
      "source": "/excursiones/buggy-en-grupo",
      "destination": "/excursiones/buggy-maimon-playa-teco",
      "permanent": true
    }
  ]
}
